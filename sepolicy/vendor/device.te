type fingerprint_device, dev_type;

type hall_device, dev_type;

type sound_device, dev_type;

type ultrasound_device, dev_type;

############################################
# Qualcomm diag access (common for SM8250)
############################################

allow {
    rild
    vendor_netmgrd
    vendor_cnd
    vendor_qti
    vendor_dpmd
    vendor_adpl
    vendor_hal_imsrtp
    hal_sensors_default
    hal_audio_default
    hal_graphics_composer_default
} vendor_diag_device:chr_file rw_file_perms;


############################################
# Debug properties
############################################

allow {
    rild
    vendor_hal_gnss_qti
} vendor_pd_locater_dbg_prop:file r_file_perms;


############################################
# Default property reads
############################################

allow {
    rild
    hal_sensors_default
    vendor_qtidataservices_app
    gamebar_app
} default_prop:file r_file_perms;


############################################
# Vendor firmware lookup
############################################

allow surfaceflinger vendor_firmware_file:dir search;


############################################
# Qualcomm capability configstore debug
############################################

allow vendor_hal_capabilityconfigstore_qti_default vendor_cap_configstore_dbg_prop:file r_file_perms;


############################################
# USB HAL
############################################

allow vendor_hal_usb_qti sysfs_iio:dir search;


############################################
# vold spunvm
############################################

allow vold vendor_spunvm_file:dir r_dir_perms;


############################################
# vendor init fingerprint persist
############################################

allow vendor_init fingerprint_data_file:dir getattr;
