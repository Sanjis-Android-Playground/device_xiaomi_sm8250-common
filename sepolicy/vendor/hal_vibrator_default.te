# The AW8697 HAL drives the haptic actuator through the input FF interface and
# the driver's own sysfs nodes instead of the QTI haptics ABI.
allow hal_vibrator_default input_device:dir r_dir_perms;
allow hal_vibrator_default input_device:chr_file rw_file_perms;

# custom_wave carries the RTP ring metadata and accepts the waveform payload;
# gain and f0_value are read and written next to it.
allow hal_vibrator_default sysfs_haptic_aw8697:dir r_dir_perms;
allow hal_vibrator_default sysfs_haptic_aw8697:file rw_file_perms;

# RichTap HAL: /dev/awinic_haptic and the AAC config on /odm.
allow hal_vibrator_default aac_richtap_device:chr_file rw_file_perms;
allow hal_vibrator_default vendor_configs_file:file r_file_perms;
